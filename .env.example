PORT=5001
NODE_ENV=development

# Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/cakezake-orders

# MongoDB Atlas (production) — uncomment and replace when deploying
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/cakezake-orders

SESSION_SECRET=your_random_secret_here
SESSION_MAX_AGE=28800000

# ── HTTPS (set to true when behind SSL/nginx in production) ──────────────────
# HTTPS=true

# ── Platform Owner (SaaS superadmin) ─────────────────────────────────────────
# ALL THREE must be set for platform owner to be auto-created on first boot.
PLATFORM_OWNER_EMAIL=rawindhakal@gmail.com
PLATFORM_OWNER_PASSWORD=YourSecurePasswordHere
PLATFORM_OWNER_USERNAME=rawindhakal
PLATFORM_OWNER_NAME=Rabin Dhakal

# ── Default CakeZake tenant (auto-created on first boot) ─────────────────────
DEFAULT_TENANT_SLUG=cakezake
DEFAULT_TENANT_NAME=CakeZake
DEFAULT_TENANT_CITY=Birtamode
DEFAULT_TENANT_COUNTRY=Nepal
DEFAULT_TENANT_CURRENCY=NPR
DEFAULT_TENANT_PREFIX=CZ
DEFAULT_ADMIN_USERNAME=cakezake
DEFAULT_ADMIN_PASSWORD=ChangeThisPasswordImmediately

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

OWNER_PHONE=+977984XXXXXXX

CLIENT_URL=http://localhost:5173
SERVER_URL=https://orders.cakezake.com

# Meta (Facebook, Instagram, WhatsApp Business Cloud API)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token

# TikTok (for comment management)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
