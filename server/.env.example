# ─────────────────────────────────────────────────────────────
#  CakeZake Order Management — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB ───────────────────────────────────────────────────
# Use your Atlas connection string in production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/cakezake-orders?retryWrites=true&w=majority

# ── Session ───────────────────────────────────────────────────
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string_in_production
SESSION_MAX_AGE=28800000

# ── HTTPS (set to true when behind SSL/nginx) ─────────────────
HTTPS=true

# ── Client origin (CORS) ──────────────────────────────────────
CLIENT_URL=https://orders.cakezake.com
SERVER_URL=https://orders.cakezake.com

# ── Platform Owner (SaaS superadmin — created on first boot) ──
# All three must be set for the platform owner to be auto-created.
PLATFORM_OWNER_EMAIL=rawindhakal@gmail.com
PLATFORM_OWNER_PASSWORD=YourSecurePasswordHere
PLATFORM_OWNER_USERNAME=rawindhakal
PLATFORM_OWNER_NAME=Rabin Dhakal

# ── Default Tenant (auto-created on first boot) ───────────────
DEFAULT_TENANT_SLUG=cakezake
DEFAULT_TENANT_NAME=CakeZake
DEFAULT_TENANT_CITY=Birtamode
DEFAULT_TENANT_COUNTRY=Nepal
DEFAULT_TENANT_CURRENCY=NPR
DEFAULT_TENANT_PREFIX=CZ

# Default tenant admin account (if no super_admin exists yet)
DEFAULT_ADMIN_USERNAME=cakezake
DEFAULT_ADMIN_PASSWORD=ChangeThisPasswordImmediately

# ── Cloudinary (image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SparrowSMS (Nepal SMS gateway) ───────────────────────────
SPARROWSMS_TOKEN=your_sparrowsms_token_here
SPARROWSMS_FROM=CakeZake

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=CakeZake <your_email@gmail.com>

# ── Business phone ────────────────────────────────────────────
OWNER_PHONE=+977984XXXXXXX

# ── Optional tuning ───────────────────────────────────────────
JSON_BODY_LIMIT=50mb
